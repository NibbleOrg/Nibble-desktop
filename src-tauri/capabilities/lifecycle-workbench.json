{
  "identifier": "lifecycle-workbench",
  "description": "Read lifecycle, system calendar preferences, and receive settings navigation only.",
  "windows": ["workbench"],
  "permissions": [
    "allow-lifecycle-snapshot",
    "allow-settings-acknowledged",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-calendar-preferences",
    "allow-settings-snapshot",
    "allow-settings-save"
  ]
}
