{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nibble Local",
  "version": "0.1.0",
  "identifier": "org.nibble.desktop.local",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "workbench",
        "title": "Nibble — Workbench",
        "url": "index.html?surface=workbench",
        "width": 960,
        "height": 680
      },
      {
        "label": "quick-panel",
        "title": "Nibble — Quick Panel",
        "url": "index.html?surface=quick-panel",
        "width": 650,
        "height": 300,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "macOS": { "minimumSystemVersion": "14.0" } }
}
